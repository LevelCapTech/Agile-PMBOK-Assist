# Application
APP_REPO_URL=git@github.com:example/app.git
APP_BRANCH=main
APP_DIR=/var/www/app
APP_USER=appuser

# Node.js (NodeSource のメジャー番号のみ。例: 20)
NODE_VERSION=20

# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_APP_DB=app_db
MYSQL_APP_USER=app_user
MYSQL_APP_PASSWORD=change_me
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change_me
# DATABASE_URL は必要に応じて明示指定
# DATABASE_URL=mysql://app_user:change_me@127.0.0.1:3306/app_db

# SSH/UFW
SSH_ALLOW_IPS="203.0.113.10"

# Let's Encrypt
ACME_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
ACME_CHALLENGE=tls-alpn-01
# DNS-01 を使う場合は DNS プラグイン情報を設定
CERTBOT_DNS_PLUGIN=
CERTBOT_DNS_CREDENTIALS=

# Monitoring
METRICS_ALLOW_IPS="203.0.113.10"

# Postfix
POSTFIX_RELAY_HOST=smtp.sakura.ne.jp
POSTFIX_RELAY_PORT=587
POSTFIX_RELAY_USER=user@example.com
POSTFIX_RELAY_PASS=change_me
ALERT_FROM=root@app.example.com
ALERT_TO=alert@example.com

# Locale
TIMEZONE=Asia/Tokyo
LANG=ja_JP.UTF-8
