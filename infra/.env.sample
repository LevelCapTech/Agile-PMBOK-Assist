# Application
APP_REPO_URL=https://github.com/example/app.git
APP_BRANCH=main
APP_DIR=/opt/agile-pmbok-assist_repo
APP_USER=appuser
APP_ENV_FILE=/opt/agile-pmbok-assist_repo/app.env
# APP_PORT と app.env の PORT を一致させる
APP_PORT=4000

# GitHub App (HTTPS pull 用)
# GITHUB_APP_ID: GitHub App の設定画面 (Settings > Developer settings > GitHub Apps > App > General) の App ID
GITHUB_APP_ID=123456
# GITHUB_INSTALLATION_ID: インストール画面の URL 末尾の ID
GITHUB_INSTALLATION_ID=12345678
GITHUB_APP_PEM_PATH=/etc/app/github-app.pem

# Node.js (NodeSource のメジャー番号のみ。例: 20)
NODE_VERSION=20

# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_APP_DB=app_db
MYSQL_APP_USER=app_user
MYSQL_APP_PASSWORD=change_me
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change_me
# DATABASE_URL は未指定の場合に MYSQL_* から自動生成されます
# DATABASE_URL=mysql://app_user:change_me@127.0.0.1:3306/app_db

# Let's Encrypt
ACME_DOMAIN=app.example.com
ACME_EMAIL=admin@example.com
ACME_CHALLENGE=tls-alpn-01
# DNS-01 を使う場合は DNS プラグイン情報を設定
CERTBOT_DNS_PLUGIN=
CERTBOT_DNS_CREDENTIALS=

# Monitoring
# METRICS_ALLOW_IPS を未指定の場合は全IP許可（推奨しないため明示指定してください）
# METRICS_ALLOW_IPS="203.0.113.10 203.0.113.20"

# Postfix
POSTFIX_MAILNAME=app.example.com
POSTFIX_RELAY_HOST=smtp.sakura.ne.jp
POSTFIX_RELAY_PORT=587
POSTFIX_RELAY_USER=user@example.com
POSTFIX_RELAY_PASS=change_me
ALERT_FROM=root@app.example.com
ALERT_TO=alert@example.com

# Locale
TIMEZONE=Asia/Tokyo
LANG=ja_JP.UTF-8
