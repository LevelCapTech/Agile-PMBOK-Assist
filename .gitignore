# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/docs/draft/*.md
/docs/draft/**/*.md
!/docs/draft/readme.md

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/storybook-static/

# production
/build
/mock/v1/web/dist
.ci-artifacts/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!infra/.env.sample

# vercel
.vercel

# Playwright
/playwright-report/
/test-results/

# typescript
*.tsbuildinfo
next-env.d.ts
